# PostgreSQL connection (URL-encode special characters in the password)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/gym_db

# JWT signing — use a long random string in production
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated frontend origins for CORS
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://127.0.0.1:5500
